<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ═══════════════════════════════════════════════════════════
     SNIPPETS PERSONALIZADOS para el editor visual de Odoo
     Aparecen en el panel "Bloques" del website builder
     ═══════════════════════════════════════════════════════════ -->

<!-- Snippet: Tarjeta de Historia -->
<template id="snippet_historia_card" name="Gigi's — Tarjeta Historia">
    <section class="gc-section gc-section-cream">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="gc-story-card">
                        <div class="gc-story-media" style="background:var(--gc-light-blue);">
                            <img src="/gigis_corner/static/description/placeholder.png"
                                 alt="Historia" style="width:100%;height:100%;object-fit:cover;"/>
                            <div class="gc-play-btn">▶</div>
                        </div>
                        <div class="gc-story-body">
                            <span class="gc-story-tag">🌟 Tema</span>
                            <h3 class="gc-story-title">Título de la historia</h3>
                            <p class="gc-story-excerpt">Descripción breve de la historia del niño.</p>
                            <a href="#" class="gc-btn-secondary"
                               style="font-size:0.82rem;padding:0.4rem 1rem;">
                                Ver historia →
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>

<!-- Snippet: Banner CTA Coral -->
<template id="snippet_cta_banner" name="Gigi's — Banner CTA">
    <section class="gc-section">
        <div class="container">
            <div class="gc-slogan-banner">
                <h2>Tu título aquí</h2>
                <p>Texto descriptivo del banner.</p>
                <div class="d-flex gap-3 justify-content-center mt-4 flex-wrap">
                    <a href="/personalizados"
                       class="gc-btn-primary" style="background:white;color:var(--gc-coral);">
                        ✨ Acción principal
                    </a>
                    <a href="https://wa.me/525529451680" target="_blank" class="gc-btn-whatsapp">
                        💬 WhatsApp
                    </a>
                </div>
            </div>
        </div>
    </section>
</template>

<!-- Snippet: Galería 4 fotos -->
<template id="snippet_galeria" name="Gigi's — Galería de Fotos">
    <section class="gc-section gc-section-cream">
        <div class="container">
            <div class="text-center mb-4">
                <h2 class="gc-section-title">Galería</h2>
            </div>
            <div class="row g-2">
                <t t-foreach="[1,2,3,4]" t-as="i">
                    <div class="col-6 col-md-3">
                        <div class="gc-gallery-item" style="height:200px;">
                            <img src="/gigis_corner/static/description/placeholder.png"
                                 alt="Galería" style="width:100%;height:100%;object-fit:cover;"/>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </section>
</template>

<!-- Snippet: Testimonial individual -->
<template id="snippet_testimonial" name="Gigi's — Testimonio">
    <div class="gc-testimonial-card">
        <div class="gc-testi-stars">★★★★★</div>
        <p class="gc-testi-quote">
            "Escribe aquí el testimonio de la familia."
        </p>
        <div class="gc-testi-author">
            <div class="gc-testi-avatar" style="background:var(--gc-coral);">A</div>
            <div>
                <div class="gc-testi-name">Nombre de la mamá/papá</div>
                <div class="gc-testi-role">Mamá de (nombre del niño)</div>
            </div>
        </div>
    </div>
</template>

<!-- Registro de snippets en el editor -->
<template id="snippets_gigis" inherit_id="website.snippets">
    <xpath expr="//div[@id='snippet_groups']" position="before">
        <div id="gc_snippets_group">
            <div class="o_panel_header">Gigi's Corner</div>
            <div class="o_panel_body">
                <t t-snippet="gigis_corner.snippet_historia_card"
                   t-thumbnail="/gigis_corner/static/description/snip_historia.png">
                    <span>Historia Card</span>
                </t>
                <t t-snippet="gigis_corner.snippet_cta_banner"
                   t-thumbnail="/gigis_corner/static/description/snip_cta.png">
                    <span>Banner CTA</span>
                </t>
                <t t-snippet="gigis_corner.snippet_galeria"
                   t-thumbnail="/gigis_corner/static/description/snip_galeria.png">
                    <span>Galería</span>
                </t>
            </div>
        </div>
    </xpath>
</template>

</odoo>
