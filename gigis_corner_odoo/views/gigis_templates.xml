<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ═══════════════════════════════════════════════════════════
     LAYOUT BASE — hereda de website.layout
     ═══════════════════════════════════════════════════════════ -->

<template id="gigis_layout" name="Gigi's Corner Layout" inherit_id="website.layout">

    <!-- NAVBAR PERSONALIZADO -->
    <xpath expr="//nav[hasclass('navbar')]" position="replace">
        <nav class="gc-navbar navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand" href="/">
                    <t t-call="website.placeholder_image">
                        <t t-set="type">'image'</t>
                        <t t-set="href">'/web/image/website/2/logo'</t>
                        <t t-set="alt">"Gigi's Corner"</t>
                        <t t-set="class">'gc-logo'</t>
                    </t>
                    <img src="/web/image/website/2/logo"
                         alt="Gigi's Corner" style="height:50px;"
                         onerror="this.style.display='none';this.nextSibling.style.display='inline'"/>
                    <span style="display:none;font-family:'Fredoka One',sans-serif;
                                 color:var(--gc-coral);font-size:1.4rem;">Gigi's Corner</span>
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#gcNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="gcNavbar">
                    <ul class="navbar-nav mx-auto gap-1">
                        <li class="nav-item">
                            <a class="nav-link" href="/">🏠 Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/historias">📖 Historias</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/nosotros">❤️ Nosotros</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/personalizados">✨ Personalizados</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/shop">🛍️ Tienda</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <!-- WhatsApp icono -->
                        <a href="https://wa.me/525529451680" target="_blank"
                           class="btn" style="color:#25D366;font-size:1.3rem;padding:0.3rem 0.6rem;"
                           title="WhatsApp">💬</a>
                        <!-- CTA principal -->
                        <a href="/personalizados" class="gc-btn-nav-cta btn">
                            💡 Diseñar mi lámpara
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </xpath>

    <!-- FOOTER PERSONALIZADO -->
    <xpath expr="//footer" position="replace">
        <footer class="gc-footer">
            <div class="container">
                <div class="row g-4">
                    <!-- Col 1: Marca -->
                    <div class="col-lg-4">
                        <div class="gc-footer-logo">
                            <img src="/web/image/website/2/logo" alt="Gigi's Corner"
                                 onerror="this.outerHTML='&lt;span style=&quot;font-family:Fredoka One,sans-serif;color:white;font-size:1.4rem;&quot;&gt;Gigi\'s Corner&lt;/span&gt;'"/>
                        </div>
                        <p class="gc-footer-tagline">
                            "Iluminando historias, sueños y recuerdos."
                        </p>
                        <div class="gc-footer-social">
                            <a href="https://www.instagram.com/gigis_corner.com.mx"
                               target="_blank" title="Instagram">
                                <i class="fa fa-instagram"></i>
                            </a>
                            <a href="https://www.facebook.com/gigiscorner"
                               target="_blank" title="Facebook">
                                <i class="fa fa-facebook"></i>
                            </a>
                            <a href="https://wa.me/525529451680"
                               target="_blank" title="WhatsApp">
                                <i class="fa fa-whatsapp"></i>
                            </a>
                            <a href="https://www.tiktok.com/@gigis_corner.com.mx"
                               target="_blank" title="TikTok">
                                <i class="fa fa-music"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Col 2: Navegación -->
                    <div class="col-lg-2 col-6">
                        <h5>Páginas</h5>
                        <ul>
                            <li><a href="/">Inicio</a></li>
                            <li><a href="/historias">Historias</a></li>
                            <li><a href="/nosotros">Nosotros</a></li>
                            <li><a href="/personalizados">Personalizados</a></li>
                            <li><a href="/shop">Tienda</a></li>
                        </ul>
                    </div>

                    <!-- Col 3: Historias -->
                    <div class="col-lg-2 col-6">
                        <h5>Historias</h5>
                        <ul>
                            <li><a href="/historias/amira-y-el-mar">Amira y el Mar</a></li>
                            <li><a href="/historias/pepe-la-tortuga">Pepe la Tortuga</a></li>
                            <li><a href="/historias/valentina-astronauta">Valentina Astronauta</a></li>
                            <li><a href="/historias/mateo-constructor">Mateo Constructor</a></li>
                        </ul>
                    </div>

                    <!-- Col 4: Contacto -->
                    <div class="col-lg-4">
                        <h5>Contacto</h5>
                        <ul>
                            <li>
                                <a href="https://wa.me/525529451680" target="_blank">
                                    💬 +52 55 2945 1680
                                </a>
                            </li>
                            <li>
                                <a href="mailto:info@gigiscorner.com.mx">
                                    📧 info@gigiscorner.com.mx
                                </a>
                            </li>
                            <li style="color:rgba(255,255,255,0.6);font-size:0.88rem;margin-top:0.5rem;">
                                📍 Benito Juárez 95, Isidro Fabela,<br/>Tlalpan, CDMX
                            </li>
                        </ul>
                        <a href="/personalizados"
                           class="gc-btn-primary mt-3 d-inline-flex"
                           style="font-size:0.85rem;padding:0.6rem 1.3rem;">
                            ✨ Diseñar mi lámpara
                        </a>
                    </div>
                </div>

                <hr class="gc-footer-divider"/>
                <div class="d-flex flex-wrap justify-content-between gc-footer-bottom">
                    <span>© 2024 Gigi's Corner. Hecho con ❤️ en CDMX, México.</span>
                    <span>
                        <a href="/page/privacidad">Privacidad</a> ·
                        <a href="/contactus">Contacto</a>
                    </span>
                </div>
            </div>
        </footer>

        <!-- WhatsApp Flotante -->
        <a href="https://wa.me/525529451680?text=Hola%2C%20me%20interesa%20una%20l%C3%A1mpara%20personalizada%20para%20mi%20peque%C3%B1o%20✨"
           target="_blank" class="gc-whatsapp-float" title="Escríbenos por WhatsApp">
            💬
        </a>
    </xpath>

</template>

<!-- ═══════════════════════════════════════════════════════════
     MODELO: Solicitud de Personalización
     ═══════════════════════════════════════════════════════════ -->
<record id="model_gigis_personalizacion" model="ir.model">
    <field name="name">Gigi's Corner - Solicitud de Personalización</field>
    <field name="model">gigis.personalizacion</field>
    <field name="state">manual</field>
</record>

</odoo>
