<!-- ═══════════════════════════════════════════════════════════
     PÁGINA DETALLE: AMIRA Y EL MAR
     ═══════════════════════════════════════════════════════════ -->
<template id="view_historia_amira" name="Historia: Amira y el Mar">
<t t-call="website.layout">
<div id="wrap">

    <section class="gc-section gc-section-blue">
        <div class="container">
            <div class="row g-5">

                <!-- Media principal -->
                <div class="col-lg-6">
                    <div class="gc-story-detail-hero">
                        <!-- ▼▼▼ VIDEO O FOTO PRINCIPAL DE AMIRA ▼▼▼ -->
                        <div class="gc-media-placeholder" style="height:100%;background:linear-gradient(135deg,var(--gc-light-blue),var(--gc-mint));">
                            <span class="gc-ph-icon" style="font-size:4rem;">🌊</span>
                            <span class="gc-ph-text" style="font-size:0.9rem;">
                                Video principal de Amira y el Mar<br/>
                                <small>Reemplaza desde el editor de Odoo</small>
                            </span>
                        </div>
                    </div>

                    <!-- Galería del proceso -->
                    <div class="row g-2 mt-2">
                        <t t-foreach="['🎨 Pintando','✂️ Cortando','🔨 Armando','💡 Resultado']" t-as="paso">
                            <div class="col-3">
                                <div class="gc-gallery-item" style="height:80px;">
                                    <!-- ▼▼▼ FOTOS PROCESO AMIRA ▼▼▼ -->
                                    <div class="gc-media-placeholder" style="height:100%;">
                                        <span style="font-size:1rem;"><t t-esc="paso.split(' ')[0]"/></span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Historia -->
                <div class="col-lg-6">
                    <a href="/historias" style="color:var(--gc-blue);font-size:0.85rem;
                       text-decoration:none;">← Todas las historias</a>
                    <span class="gc-section-label mt-3 d-block" style="width:fit-content;">🌊 Historia real</span>
                    <h1 class="gc-section-title" style="font-size:2.2rem;">Amira y el Mar</h1>

                    <div class="gc-chapter mt-3">
                        <div class="gc-chapter-num">La historia</div>
                        <p class="gc-chapter-text">
                            <!-- ▼▼▼ EDITA ESTA HISTORIA ▼▼▼ -->
                            Amira siempre soñaba con el mar. Sus ojos brillaban cada vez que veía el océano en
                            un libro o en una película. Sus papás querían que ese amor por el mar viviera también
                            en su habitación, iluminando cada noche.
                        </p>
                    </div>

                    <div class="gc-chapter">
                        <div class="gc-chapter-num">El proceso</div>
                        <p class="gc-chapter-text">
                            Conversamos con su mamá durante más de una hora sobre la personalidad de Amira,
                            sus colores favoritos, su amor por las olas y los peces de colores. Diseñamos
                            cada pieza pensando en ella, cortamos el MDF con precisión y pintamos a mano
                            cada detalle del océano que la hace soñar.
                        </p>
                    </div>

                    <div class="gc-chapter" style="border-color:var(--gc-coral);">
                        <div class="gc-chapter-num" style="color:var(--gc-coral);">El resultado ❤️</div>
                        <p class="gc-chapter-text">
                            Una lámpara que hace brillar los ojos de Amira cada noche cuando se enciende
                            y su nombre ilumina las paredes de su cuarto. Su mamá nos dijo que Amira
                            la abraza antes de dormir.
                        </p>
                    </div>

                    <div class="d-flex gap-3 mt-4 flex-wrap">
                        <a href="/personalizados" class="gc-btn-primary">
                            ✨ Quiero una lámpara así
                        </a>
                        <a href="https://wa.me/525529451680" target="_blank"
                           class="gc-btn-whatsapp">
                            💬 Preguntar a Ana
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>

</div>
</t>
</template>

</odoo>
