                <!-- ── PLACEHOLDER: TU HISTORIA AQUÍ ── -->
                <div class="col-md-6 col-lg-3 gc-fade-up gc-delay-1">
                    <a href="/personalizados" class="gc-story-card"
                       style="border:2.5px dashed var(--gc-blue);background:transparent;box-shadow:none;">
