    <!-- HISTORIA DETALLE: AMIRA (URL: /historias/amira-y-el-mar) -->
    <!-- Esta sección se activa cuando se llega a la URL específica -->
    <!-- Odoo Blog maneja las páginas individuales automáticamente -->

    <!-- CTA FINAL -->
    <section class="gc-section" style="background:var(--gc-navy);">
        <div class="container text-center">
            <h2 style="font-family:var(--font-title);color:white;font-size:1.8rem;">
                ¿Lista para crear la historia de tu pequeño?
