<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ═══════════════════════════════════════════
             WEBSITE CONFIGURATION
        ═══════════════════════════════════════════ -->
        <record id="gigis_website" model="website">
            <field name="name">Gigi's Corner</field>
            <field name="domain">https://gigiscorner.com.mx</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- ═══════════════════════════════════════════
             STATIC PAGES
        ═══════════════════════════════════════════ -->
        <record id="page_historias" model="website.page">
            <field name="name">Historias</field>
            <field name="url">/historias</field>
            <field name="view_id" ref="gigis_corner.view_historias_page"/>
            <field name="website_published">True</field>
            <field name="is_homepage">False</field>
        </record>

        <record id="page_nosotros" model="website.page">
            <field name="name">Nosotros</field>
            <field name="url">/nosotros</field>
            <field name="view_id" ref="gigis_corner.view_nosotros_page"/>
            <field name="website_published">True</field>
            <field name="is_homepage">False</field>
        </record>

        <record id="page_personalizado" model="website.page">
            <field name="name">Personalizados</field>
            <field name="url">/personalizados</field>
            <field name="view_id" ref="gigis_corner.view_personalizado_page"/>
            <field name="website_published">True</field>
            <field name="is_homepage">False</field>
        </record>

        <!-- ═══════════════════════════════════════════
             CRM PIPELINE STAGE
        ═══════════════════════════════════════════ -->
        <record id="crm_stage_personalizacion" model="crm.stage">
            <field name="name">Solicitud Personalización</field>
            <field name="sequence">1</field>
        </record>

    </data>
</odoo>
