<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         FORMULARIO — gigis.categoria (backend / administración)
         ═══════════════════════════════════════════════════════════ -->
    <record id="view_gigis_categoria_form" model="ir.ui.view">
        <field name="name">gigis.categoria.form</field>
        <field name="model">gigis.categoria</field>
        <field name="arch" type="xml">
            <form string="Categoría">
                <sheet>
                    <field name="imagen_hero" widget="image" class="oe_avatar"
                           options="{'size': [400, 300]}"/>
                    <div class="oe_title">
                        <label for="titulo"/>
                        <h1>
                            <field name="titulo" placeholder="Ej: Aventuras al Mar"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Datos básicos">
                            <field name="slug" placeholder="aventuras-mar"/>
                            <field name="emoji" placeholder="🌊"/>
                            <field name="color" placeholder="#D6EDFB"/>
                        </group>
                        <group string="Publicación">
                            <field name="sequence"/>
                            <field name="website_published"/>
                            <field name="active"/>
                            <field name="public_category_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <group string="Encabezado (se muestra arriba en la web)">
                        <field name="descripcion" placeholder="Frase corta que describe la categoría."/>
                        <field name="video_url"
                               placeholder="https://...  (YouTube, Vimeo o .mp4) — opcional, muestra el botón ▶"/>
                    </group>

                    <notebook>
                        <page string="Ejemplos (tarjetas)">
                            <group>
                                <field name="seccion_etiqueta" placeholder="Ejemplos de esta categoría"/>
                                <field name="seccion_titulo" placeholder="Lámparas que inspiran"/>
                            </group>
                            <field name="ejemplo_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="imagen" widget="image" class="oe_avatar" options="{'size': [100, 100]}"/>
                                    <field name="titulo"/>
                                    <field name="descripcion"/>
                                    <field name="video_url" placeholder="URL video (opcional)"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         LISTA — gigis.categoria
         ═══════════════════════════════════════════════════════════ -->
    <record id="view_gigis_categoria_tree" model="ir.ui.view">
        <field name="name">gigis.categoria.tree</field>
        <field name="model">gigis.categoria</field>
        <field name="arch" type="xml">
            <tree string="Categorías">
                <field name="sequence" widget="handle"/>
                <field name="emoji"/>
                <field name="titulo"/>
                <field name="slug"/>
                <field name="website_published"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         KANBAN (con miniatura)
         ═══════════════════════════════════════════════════════════ -->
    <record id="view_gigis_categoria_kanban" model="ir.ui.view">
        <field name="name">gigis.categoria.kanban</field>
        <field name="model">gigis.categoria</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="titulo"/>
                <field name="slug"/>
                <field name="emoji"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <field name="imagen_hero" widget="image"
                                   class="o_kanban_image_fill_left"
                                   options="{'zoom': true, 'background': true, 'preventClicks': false}"/>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="emoji"/> <field name="titulo"/>
                                </strong>
                                <div class="text-muted">
                                    /categoria/<field name="slug"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         ACCIÓN + MENÚ
         ═══════════════════════════════════════════════════════════ -->
    <record id="action_gigis_categoria" model="ir.actions.act_window">
        <field name="name">Categorías</field>
        <field name="res_model">gigis.categoria</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea la primera categoría de Gigi's Corner
            </p>
            <p>
                Cada categoría aparece en /categoria/&lt;slug&gt;.
                Sube aquí la imagen del encabezado, el video y los ejemplos.
            </p>
        </field>
    </record>

    <menuitem id="menu_gigis_categorias_admin"
              name="Categorías"
              parent="menu_gigis_root"
              action="action_gigis_categoria"
              sequence="15"/>

</odoo>
