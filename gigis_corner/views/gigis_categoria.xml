<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ═══════════════════════════════════════════════════════════
     PÁGINA: CATEGORÍA  — /categoria/<slug>
     El controlador pasa 'cat' (dict) y 'slug'
     ═══════════════════════════════════════════════════════════ -->
<template id="view_categoria_page" name="Gigi's Corner — Categoría">
<t t-call="website.layout">
<div id="wrap">

    <!-- HERO con imagen grande editable (una por categoría, doble clic para cambiar) -->
    <section style="position:relative;overflow:hidden;">
        <div class="gc-img-box" style="height:340px;">
            <t t-if="slug == 'dulces-suenos'">
                <img src="/gigis_corner/static/src/img/samples/cat_dulces.jpg" alt="Dulces Sueños" class="gc-img-cover"/>
            </t>
            <t t-elif="slug == 'suena-grande'">
                <img src="/gigis_corner/static/src/img/samples/cat_suena.jpg" alt="Sueña en Grande" class="gc-img-cover"/>
            </t>
            <t t-elif="slug == 'exploradores'">
                <img src="/gigis_corner/static/src/img/samples/cat_explora.jpg" alt="Pequeños Exploradores" class="gc-img-cover"/>
            </t>
            <t t-elif="slug == 'amigos-especiales'">
                <img src="/gigis_corner/static/src/img/samples/cat_amigos.jpg" alt="Amigos Especiales" class="gc-img-cover"/>
            </t>
            <t t-else="">
                <img src="/gigis_corner/static/src/img/samples/cat_mar.jpg" alt="Aventuras al Mar" class="gc-img-cover"/>
            </t>
        </div>
        <div style="position:absolute;inset:0;background:rgba(30,58,95,0.32);
                    display:flex;flex-direction:column;align-items:center;justify-content:center;
                    text-align:center;padding:0 1rem;">
            <span style="font-size:3.2rem;line-height:1;"><t t-esc="cat['emoji']"/></span>
            <h1 style="font-family:'Fredoka One',cursive;color:white;font-size:2.4rem;
                       margin:0.6rem 0 0.3rem;text-shadow:0 2px 12px rgba(0,0,0,0.25);">
                <t t-esc="cat['titulo']"/>
            </h1>
            <p style="color:white;font-size:1rem;max-width:560px;
                      text-shadow:0 1px 8px rgba(0,0,0,0.3);margin:0;">
                <t t-esc="cat['descripcion']"/>
            </p>
        </div>
    </section>

    <!-- BLOQUES DE EJEMPLOS — imagen + texto editables -->
    <section style="background:#F7F3EB;padding:4rem 0;">
        <div class="container">
            <div class="text-center" style="margin-bottom:2.5rem;">
                <span style="display:inline-block;background:#5DA7E8;color:white;font-size:0.78rem;
                             font-weight:700;padding:0.3rem 1rem;border-radius:50px;margin-bottom:1rem;">
                    Ejemplos de esta categoría
                </span>
                <h2 style="font-family:'Fredoka One',cursive;font-size:1.9rem;color:#1E3A5F;margin:0;">
                    Lámparas que inspiran
                </h2>
            </div>

            <div class="row g-4">
                <div class="col-12 col-md-4 gc-fade-up">
                    <div style="background:white;border-radius:18px;overflow:hidden;height:100%;box-shadow:0 4px 24px rgba(93,167,232,0.13);">
                        <!-- ▼▼▼ Imagen editable (doble clic para cambiar) ▼▼▼ -->
                        <div class="gc-img-box" style="height:200px;">
                            <img src="/gigis_corner/static/src/img/samples/catpg_1.jpg" alt="Diseño 1" class="gc-img-cover"/>
                        </div>
                        <div style="padding:1.3rem;">
                            <h4 style="font-family:'Fredoka One',cursive;font-size:1.1rem;color:#1E3A5F;margin:0 0 0.5rem;">Diseño 1</h4>
                            <p style="font-size:0.88rem;color:#4B4B4B;opacity:0.8;line-height:1.6;margin:0;">Una lámpara pensada al detalle para tu pequeño.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4 gc-fade-up">
                    <div style="background:white;border-radius:18px;overflow:hidden;height:100%;box-shadow:0 4px 24px rgba(93,167,232,0.13);">
                        <div class="gc-img-box" style="height:200px;">
                            <img src="/gigis_corner/static/src/img/samples/catpg_2.jpg" alt="Diseño 2" class="gc-img-cover"/>
                        </div>
                        <div style="padding:1.3rem;">
                            <h4 style="font-family:'Fredoka One',cursive;font-size:1.1rem;color:#1E3A5F;margin:0 0 0.5rem;">Diseño 2</h4>
                            <p style="font-size:0.88rem;color:#4B4B4B;opacity:0.8;line-height:1.6;margin:0;">Colores suaves y pintura hecha a mano.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4 gc-fade-up">
                    <div style="background:white;border-radius:18px;overflow:hidden;height:100%;box-shadow:0 4px 24px rgba(93,167,232,0.13);">
                        <div class="gc-img-box" style="height:200px;">
                            <img src="/gigis_corner/static/src/img/samples/catpg_3.jpg" alt="Diseño 3" class="gc-img-cover"/>
                        </div>
                        <div style="padding:1.3rem;">
                            <h4 style="font-family:'Fredoka One',cursive;font-size:1.1rem;color:#1E3A5F;margin:0 0 0.5rem;">Diseño 3</h4>
                            <p style="font-size:0.88rem;color:#4B4B4B;opacity:0.8;line-height:1.6;margin:0;">Personalizada con el nombre y la historia.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CTA -->
            <div class="text-center" style="margin-top:3rem;">
                <a href="/personalizados"
                   style="display:inline-flex;align-items:center;gap:0.5rem;background:#FF5C64;
                          color:white;border-radius:50px;padding:0.8rem 2rem;font-weight:700;
                          font-size:0.95rem;text-decoration:none;">
                    Quiero una lámpara así ✨
                </a>
                <a href="/historias"
                   style="display:inline-flex;align-items:center;gap:0.5rem;color:#5DA7E8;
                          border:2px solid #5DA7E8;border-radius:50px;padding:0.78rem 1.9rem;
                          font-weight:700;font-size:0.95rem;text-decoration:none;background:transparent;
                          margin-left:0.6rem;">
                    Ver historias reales
                </a>
            </div>
        </div>
    </section>

</div>
</t>
</template>

</odoo>
