<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════
         ASSETS — Forma correcta en Odoo 17 Community
         Se hereda web.assets_frontend para agregar CSS y JS
    ═══════════════════════════════════════════════════════════ -->
    <template id="gigis_assets_frontend" inherit_id="web.assets_frontend" name="Gigi's Corner Assets">
        <xpath expr="." position="inside">
            <link rel="stylesheet" type="text/css"
                  href="/gigis_corner/static/src/css/gigis_main.css"/>
            <link rel="stylesheet" type="text/css"
                  href="/gigis_corner/static/src/css/gigis_animations.css"/>
            <script type="text/javascript"
                    src="/gigis_corner/static/src/js/gigis_main.js"/>
        </xpath>
    </template>

</odoo>
