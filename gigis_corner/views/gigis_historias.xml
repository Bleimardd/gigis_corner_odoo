<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ═══════════════════════════════════════════════════════════
     VISTA: LISTA DE HISTORIAS  — /historias
     El controlador pasa la variable 'historias' (gigis.historia)
     ═══════════════════════════════════════════════════════════ -->
<template id="view_historias_page" name="Gigi's Corner — Historias">
<t t-call="website.layout">
<div id="wrap">

    <!-- HERO -->
    <section style="background:linear-gradient(135deg,#E8F4FD,#EEF9F7);padding:4rem 0 2.5rem;">
        <div class="container text-center">
            <span class="gc-section-label">Historias reales</span>
            <h1 class="gc-section-title mt-2" style="font-size:2.4rem;">
                Historias que iluminan 🌟
            </h1>
            <p class="gc-section-sub">
                Cada lámpara tiene una historia real.<br/>
                Conoce a los pequeños cuyos sueños se convirtieron en luz.
            </p>
        </div>
    </section>

    <!-- GRID DE HISTORIAS (desde la BD) -->
    <section class="gc-section gc-section-cream">
        <div class="container">
            <div class="row g-4">

                <!-- Itera sobre las historias publicadas -->
                <t t-foreach="historias" t-as="h">
                    <div class="col-md-6 col-lg-3 gc-fade-up">
                        <a t-attf-href="/historias/#{h.slug}" class="gc-story-card">
                            <div class="gc-story-media"
                                 t-attf-style="background:#{h.color_fondo};">
                                <!-- Foto si existe, si no placeholder -->
                                <t t-if="h.imagen_principal">
                                    <img t-attf-src="/web/image/gigis.historia/#{h.id}/imagen_principal"
                                         t-att-alt="h.titulo"
                                         style="width:100%;height:100%;object-fit:cover;"/>
                                </t>
                                <t t-else="">
                                    <div class="gc-media-placeholder">
                                        <span class="gc-ph-icon">
                                            <t t-esc="h.emoji"/>
                                        </span>
                                        <span class="gc-ph-text">
                                            📸 Foto/Video — <t t-esc="h.nombre_nino"/>
                                        </span>
                                    </div>
                                </t>
                                <!-- Botón play si hay video -->
                                <t t-if="h.video_url">
                                    <div class="gc-play-btn"
                                         t-att-data-video="h.video_url">▶</div>
                                </t>
                            </div>
                            <div class="gc-story-body">
                                <t t-if="h.etiqueta">
                                    <span class="gc-story-tag">
                                        <t t-esc="h.etiqueta"/>
                                    </span>
                                </t>
                                <h3 class="gc-story-title mt-2">
                                    <t t-esc="h.titulo"/>
                                </h3>
                                <p class="gc-story-excerpt">
                                    <t t-esc="h.extracto"/>
                                </p>
                                <span class="gc-btn-secondary"
                                      style="font-size:0.82rem;padding:0.4rem 1rem;">
                                    Ver historia →
                                </span>
                            </div>
                        </a>
                    </div>
                </t>

                <!-- Tarjeta "Tu historia aquí" siempre al final -->
                <div class="col-md-6 col-lg-3 gc-fade-up">
                    <a href="/personalizados" class="gc-story-card"
                       style="border:2.5px dashed #5DA7E8;
                              background:transparent;box-shadow:none;">
                        <div class="gc-story-media"
                             style="background:linear-gradient(135deg,
                                    #D6EDFB,#C8F5F1);height:220px;">
                            <div class="gc-media-placeholder">
                                <span class="gc-ph-icon">✨</span>
                                <span class="gc-ph-text" style="color:#5DA7E8;opacity:1;">
                                    ¿La siguiente historia<br/>es la de tu pequeño?
                                </span>
                            </div>
                        </div>
                        <div class="gc-story-body">
                            <span class="gc-story-tag"
                                  style="background:#FFE5E6;color:#FF5C64;">
                                ✨ Tu historia
                            </span>
                            <h3 class="gc-story-title">La historia de tu pequeño</h3>
                            <p class="gc-story-excerpt">
                                Cuéntanos sus sueños y la convertimos en una lámpara única.
                            </p>
                            <span class="gc-btn-primary"
                                  style="font-size:0.82rem;padding:0.4rem 1rem;">
                                Crear mi historia →
                            </span>
                        </div>
                    </a>
                </div>

            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="gc-section" style="background:#1E3A5F;">
        <div class="container text-center">
            <h2 style="font-family:'Fredoka One',cursive;color:white;font-size:1.9rem;">
                ¿Lista para crear la historia de tu pequeño?
            </h2>
            <p style="color:rgba(255,255,255,0.75);margin:1rem 0 2rem;">
                Cuéntanos sus sueños y la convertimos en la lámpara más especial de su infancia.
            </p>
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a href="/personalizados" class="gc-btn-primary">
                    Diseñar mi lámpara
                </a>
                <a href="https://wa.me/525529451680" target="_blank"
                   class="gc-btn-whatsapp">Hablar con Ana por WhatsApp</a>
            </div>
        </div>
    </section>

</div>
</t>
</template>


<!-- ═══════════════════════════════════════════════════════════
     VISTA: DETALLE DE HISTORIA  — /historias/<slug>
     El controlador pasa la variable 'historia' (gigis.historia)
     ═══════════════════════════════════════════════════════════ -->
<template id="view_historia_detalle" name="Gigi's Corner — Historia Detalle">
<t t-call="website.layout">
<div id="wrap">

    <section class="gc-section gc-section-blue">
        <div class="container">
            <div class="row g-5">

                <!-- Media principal + galería del proceso -->
                <div class="col-lg-6">
                    <div class="gc-story-detail-hero">
                        <t t-if="historia.imagen_principal">
                            <img t-attf-src="/web/image/gigis.historia/#{historia.id}/imagen_principal"
                                 t-att-alt="historia.titulo"
                                 style="width:100%;height:100%;object-fit:cover;"/>
                        </t>
                        <t t-else="">
                            <div class="gc-media-placeholder"
                                 t-attf-style="height:100%;background:#{historia.color_fondo};">
                                <span class="gc-ph-icon"
                                      style="font-size:4rem;">
                                    <t t-esc="historia.emoji"/>
                                </span>
                                <span class="gc-ph-text" style="font-size:0.9rem;">
                                    📸 Foto/Video principal — <t t-esc="historia.nombre_nino"/><br/>
                                    <small>Agrégala desde Odoo → Gigi's Corner → Historias</small>
                                </span>
                            </div>
                        </t>
                        <!-- Botón play si hay video -->
                        <t t-if="historia.video_url">
                            <div class="gc-play-btn"
                                 t-att-data-video="historia.video_url"
                                 style="cursor:pointer;">▶</div>
                        </t>
                    </div>

                    <!-- Fotos del proceso -->
                    <div class="row g-2 mt-2">
                        <t t-foreach="['foto_proceso_1','foto_proceso_2',
                                       'foto_proceso_3','foto_proceso_4']" t-as="campo">
                            <t t-if="historia[campo]">
                                <div class="col-3">
                                    <div class="gc-gallery-item" style="height:85px;">
                                        <img t-attf-src="/web/image/gigis.historia/#{historia.id}/#{campo}"
                                             t-att-alt="historia.titulo"
                                             style="width:100%;height:100%;object-fit:cover;"/>
                                    </div>
                                </div>
                            </t>
                        </t>
                    </div>
                </div>

                <!-- Texto de la historia -->
                <div class="col-lg-6">
                    <a href="/historias"
                       style="color:#5DA7E8;font-size:0.85rem;text-decoration:none;">
                        ← Todas las historias
                    </a>

                    <t t-if="historia.etiqueta">
                        <span class="gc-section-label mt-3 d-block"
                              style="width:fit-content;">
                            <t t-esc="historia.etiqueta"/>
                        </span>
                    </t>

                    <h1 class="gc-section-title" style="font-size:2.1rem;">
                        <t t-esc="historia.titulo"/>
                    </h1>
                    <t t-if="historia.subtitulo">
                        <p style="color:#4B4B4B;font-size:1rem;margin-top:0.3rem;">
                            <t t-esc="historia.subtitulo"/>
                        </p>
                    </t>

                    <!-- Capítulo: La Historia -->
                    <t t-if="historia.capitulo_historia">
                        <div class="gc-chapter mt-3">
                            <div class="gc-chapter-num">La historia</div>
                            <p class="gc-chapter-text">
                                <t t-esc="historia.capitulo_historia"/>
                            </p>
                        </div>
                    </t>

                    <!-- Capítulo: El Proceso -->
                    <t t-if="historia.capitulo_proceso">
                        <div class="gc-chapter"
                             style="border-color:#34C9B8;">
                            <div class="gc-chapter-num"
                                 style="color:#34C9B8;">El proceso</div>
                            <p class="gc-chapter-text">
                                <t t-esc="historia.capitulo_proceso"/>
                            </p>
                        </div>
                    </t>

                    <!-- Capítulo: El Resultado -->
                    <t t-if="historia.capitulo_resultado">
                        <div class="gc-chapter"
                             style="border-color:#FF5C64;">
                            <div class="gc-chapter-num"
                                 style="color:#FF5C64;">El resultado ❤️</div>
                            <p class="gc-chapter-text">
                                <t t-esc="historia.capitulo_resultado"/>
                            </p>
                        </div>
                    </t>

                    <div class="d-flex gap-3 mt-4 flex-wrap">
                        <a href="/personalizados" class="gc-btn-primary">
                            Quiero una lámpara así
                        </a>
                        <a href="https://wa.me/525529451680"
                           target="_blank" class="gc-btn-whatsapp">
                            Preguntar a Ana
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>

</div>
</t>
</template>

</odoo>
