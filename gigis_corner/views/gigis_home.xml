<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ═══════════════════════════════════════════════════════════
     HOME — PÁGINA PRINCIPAL
     ═══════════════════════════════════════════════════════════ -->
<template id="view_home_page" name="Gigi's Corner - Home">
<t t-call="website.layout">
<div id="wrap">

    <!-- ══════════════════════════════════
         SECCIÓN 1 — HERO
    ══════════════════════════════════ -->
    <section class="gc-hero">
        <div class="container">
            <div class="row align-items-center g-5">

                <!-- Texto Hero -->
                <div class="col-lg-6 gc-slide-left">
                    <span class="gc-section-label">
                        ✨ Lámparas Artesanales Personalizadas · Hecho en México 🇲🇽
                    </span>
                    <h1 class="gc-hero-title mt-2">
                        Cada niño tiene<br/>
                        una historia que<br/>
                        <span>merece ser iluminada</span>
                    </h1>
                    <p class="gc-hero-subtitle mt-3">
                        Diseñamos, armamos y pintamos a mano lámparas únicas inspiradas
                        en los sueños, recuerdos y aventuras de cada pequeño.
                    </p>
                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <a href="/historias" class="gc-btn-primary">
                            💡 Explorar Historias
                        </a>
                        <a href="/personalizados" class="gc-btn-secondary">
                            ✨ Diseñar mi lámpara
                        </a>
                    </div>
                    <!-- Stats Bar -->
                    <div class="gc-stats-bar mt-4">
                        <div class="gc-stat-item">
                            <span class="gc-stat-value gc-count-up" data-target="500" data-suffix="+">500+</span>
                            <span class="gc-stat-label">Historias iluminadas</span>
                        </div>
                        <div class="gc-stat-item">
                            <span class="gc-stat-value">100%</span>
                            <span class="gc-stat-label">Pintadas a mano</span>
                        </div>
                        <div class="gc-stat-item">
                            <span class="gc-stat-value">❤️</span>
                            <span class="gc-stat-label">Madres creadoras</span>
                        </div>
                        <div class="gc-stat-item">
                            <span class="gc-stat-value">🇲🇽</span>
                            <span class="gc-stat-label">Hecho en CDMX</span>
                        </div>
                    </div>
                </div>

                <!-- Imagen Hero -->
                <div class="col-lg-6 gc-slide-right">
                    <div class="gc-hero-media gc-float">
                        <!-- ▼▼▼ REEMPLAZA CON TU FOTO PRINCIPAL ▼▼▼ -->
                        <div class="gc-media-placeholder" style="height:100%;">
                            <span class="gc-ph-icon">💡</span>
                            <span class="gc-ph-text">
                                📸 Foto principal de lámpara<br/>
                                <small>Reemplaza desde el editor de Odoo</small>
                            </span>
                        </div>
                        <!-- ▲▲▲ FIN PLACEHOLDER ▲▲▲ -->
                        <div class="gc-hero-badge">
                            <span style="font-size:2rem;">💡</span>
                            <div>
                                <strong>HELANA</strong>
                                <span style="font-size:0.78rem;color:var(--gc-gray);">Lámpara personalizada</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>


    <!-- ══════════════════════════════════
         SECCIÓN 2 — CATEGORÍAS
    ══════════════════════════════════ -->
    <section class="gc-section gc-section-cream">
        <div class="container text-center">
            <span class="gc-section-label">Encuentra tu historia</span>
            <h2 class="gc-section-title">¿Qué historia quieres contar?</h2>
            <p class="gc-section-sub">Cada lámpara nace de un sueño, una aventura o un personaje favorito</p>

            <div class="row g-3 mt-2">
                <div class="col-6 col-md-4 col-lg-2 gc-fade-up gc-delay-1">
                    <a href="/shop?tag=dulces-suenos" class="gc-category-card"
                       style="background:var(--gc-light-blue);">
                        <span class="gc-cat-emoji">🌙</span>
                        <span class="gc-cat-name">Dulces Sueños</span>
                        <div class="gc-cat-arrow">→</div>
                    </a>
                </div>
                <div class="col-6 col-md-4 col-lg-2 gc-fade-up gc-delay-2">
                    <a href="/shop?tag=suena-grande" class="gc-category-card"
                       style="background:var(--gc-peach);">
                        <span class="gc-cat-emoji">🚀</span>
                        <span class="gc-cat-name">Sueña en Grande</span>
                        <div class="gc-cat-arrow">→</div>
                    </a>
                </div>
                <div class="col-6 col-md-4 col-lg-2 gc-fade-up gc-delay-3">
                    <a href="/shop?tag=exploradores" class="gc-category-card"
                       style="background:var(--gc-mint);">
                        <span class="gc-cat-emoji">🚜</span>
                        <span class="gc-cat-name">Pequeños Exploradores</span>
                        <div class="gc-cat-arrow">→</div>
                    </a>
                </div>
                <div class="col-6 col-md-4 col-lg-2 gc-fade-up gc-delay-4">
                    <a href="/shop?tag=amigos-especiales" class="gc-category-card"
                       style="background:#FFF0D0;">
                        <span class="gc-cat-emoji">🐢</span>
                        <span class="gc-cat-name">Amigos Especiales</span>
                        <div class="gc-cat-arrow">→</div>
                    </a>
                </div>
                <div class="col-6 col-md-4 col-lg-2 gc-fade-up gc-delay-5">
                    <a href="/shop?tag=aventuras-mar" class="gc-category-card"
                       style="background:var(--gc-light-blue);">
                        <span class="gc-cat-emoji">🌊</span>
                        <span class="gc-cat-name">Aventuras al Mar</span>
                        <div class="gc-cat-arrow">→</div>
                    </a>
                </div>
                <div class="col-6 col-md-4 col-lg-2 gc-fade-up gc-delay-1">
                    <a href="/personalizados" class="gc-category-card"
                       style="background:var(--gc-peach);">
                        <span class="gc-cat-emoji">✨</span>
                        <span class="gc-cat-name">Mi Propia Historia</span>
                        <div class="gc-cat-arrow" style="background:var(--gc-coral);">→</div>
                    </a>
                </div>
            </div>
        </div>
    </section>


    <!-- ══════════════════════════════════
         SECCIÓN 3 — HISTORIAS QUE ILUMINAN
    ══════════════════════════════════ -->
    <section class="gc-section gc-section-blue">
        <div class="container text-center">
            <span class="gc-section-label" style="background:var(--gc-blue);">📖 Historias reales</span>
            <h2 class="gc-section-title">Historias que iluminan 🌟</h2>
            <p class="gc-section-sub">Cada lámpara tiene una historia real detrás. Conoce a nuestros pequeños.</p>

            <div class="row g-4 mt-2 text-start">

                <!-- Historia 1: Amira -->
                <div class="col-md-4 gc-fade-up gc-delay-1">
                    <a href="/historias/amira-y-el-mar" class="gc-story-card">
                        <div class="gc-story-media" style="background:var(--gc-light-blue);">
                            <!-- ▼▼▼ VIDEO O FOTO DE AMIRA ▼▼▼ -->
                            <div class="gc-media-placeholder">
                                <span class="gc-ph-icon">🌊</span>
                                <span class="gc-ph-text">Video / Foto Amira<br/><small>Reemplaza desde el editor</small></span>
                            </div>
                            <div class="gc-play-btn" data-video="">▶</div>
                        </div>
                        <div class="gc-story-body">
                            <span class="gc-story-tag">🌊 Mar</span>
                            <span class="gc-story-tag">🎨 Pintado a mano</span>
                            <h3 class="gc-story-title mt-2">Amira y el Mar</h3>
                            <p class="gc-story-excerpt">
                                Una niña que soñaba con el océano recibió su propia aventura marina
                                pintada a mano, con olas y su nombre brillando en la luz de la noche.
                            </p>
                            <span class="gc-btn-secondary" style="font-size:0.82rem;padding:0.4rem 1rem;">
                                Ver historia →
                            </span>
                        </div>
                    </a>
                </div>

                <!-- Historia 2: Pepe -->
                <div class="col-md-4 gc-fade-up gc-delay-2">
                    <a href="/historias/pepe-la-tortuga" class="gc-story-card">
                        <div class="gc-story-media" style="background:var(--gc-mint);">
                            <!-- ▼▼▼ VIDEO O FOTO DE PEPE ▼▼▼ -->
                            <div class="gc-media-placeholder">
                                <span class="gc-ph-icon">🐢</span>
                                <span class="gc-ph-text">Video / Foto Pepe<br/><small>Reemplaza desde el editor</small></span>
                            </div>
                            <div class="gc-play-btn" data-video="">▶</div>
                        </div>
                        <div class="gc-story-body">
                            <span class="gc-story-tag">🐢 Amigos</span>
                            <span class="gc-story-tag">🌿 Naturaleza</span>
                            <h3 class="gc-story-title mt-2">Pepe la Tortuga</h3>
                            <p class="gc-story-excerpt">
                                La mascota favorita de un pequeño se convirtió en personaje de cuento
                                que ahora alumbra su habitación con calidez cada noche.
                            </p>
                            <span class="gc-btn-secondary" style="font-size:0.82rem;padding:0.4rem 1rem;">
                                Ver historia →
                            </span>
                        </div>
                    </a>
                </div>

                <!-- Historia 3: Valentina -->
                <div class="col-md-4 gc-fade-up gc-delay-3">
                    <a href="/historias/valentina-astronauta" class="gc-story-card">
                        <div class="gc-story-media" style="background:var(--gc-peach);">
                            <!-- ▼▼▼ VIDEO O FOTO DE VALENTINA ▼▼▼ -->
                            <div class="gc-media-placeholder">
                                <span class="gc-ph-icon">🚀</span>
                                <span class="gc-ph-text">Video / Foto Valentina<br/><small>Reemplaza desde el editor</small></span>
                            </div>
                            <div class="gc-play-btn" data-video="">▶</div>
                        </div>
                        <div class="gc-story-body">
                            <span class="gc-story-tag">🚀 Espacio</span>
                            <span class="gc-story-tag">⭐ Sueños</span>
                            <h3 class="gc-story-title mt-2">Valentina Astronauta</h3>
                            <p class="gc-story-excerpt">
                                Una niña que quería conquistar las estrellas tiene su propia misión
                                espacial iluminando cada sueño nocturno desde su habitación.
                            </p>
                            <span class="gc-btn-secondary" style="font-size:0.82rem;padding:0.4rem 1rem;">
                                Ver historia →
                            </span>
                        </div>
                    </a>
                </div>

            </div>

            <div class="mt-5">
                <a href="/historias" class="gc-btn-primary">
                    📖 Ver todas las historias
                </a>
            </div>
        </div>
    </section>


    <!-- ══════════════════════════════════
         SECCIÓN 4 — ASÍ NACE UNA LÁMPARA
    ══════════════════════════════════ -->
    <section class="gc-section gc-section-cream">
        <div class="container text-center">
            <span class="gc-section-label" style="background:var(--gc-yellow);color:var(--gc-gray);">
                🔨 Proceso artesanal
            </span>
            <h2 class="gc-section-title">Así nace una lámpara ✨</h2>
            <p class="gc-section-sub">Cada paso es un acto de amor artesanal</p>

            <div class="row g-3 mt-2">

                <!-- Paso 1 -->
                <div class="col-md-4 col-lg-2 gc-fade-up gc-delay-1">
                    <div class="gc-step-card">
                        <div class="gc-step-number" style="background:var(--gc-blue);">1</div>
                        <span class="gc-step-emoji">💡</span>
                        <h4 class="gc-step-title">Diseñamos la idea</h4>
                        <p class="gc-step-desc">Conversamos contigo sobre la historia y sueños de tu pequeño.</p>
                    </div>
                </div>

                <!-- Paso 2 -->
                <div class="col-md-4 col-lg-2 gc-fade-up gc-delay-2">
                    <div class="gc-step-card">
                        <div class="gc-step-number" style="background:var(--gc-turquoise);">2</div>
                        <span class="gc-step-emoji">✂️</span>
                        <h4 class="gc-step-title">Cortamos cada pieza</h4>
                        <p class="gc-step-desc">Con precisión artesanal cortamos el MDF según el diseño único.</p>
                    </div>
                </div>

                <!-- Paso 3 -->
                <div class="col-md-4 col-lg-2 gc-fade-up gc-delay-3">
                    <div class="gc-step-card">
                        <div class="gc-step-number" style="background:var(--gc-coral);">3</div>
                        <span class="gc-step-emoji">🔨</span>
                        <h4 class="gc-step-title">Armamos cuidadosamente</h4>
                        <p class="gc-step-desc">Cada pieza encaja perfectamente con detalle y precisión.</p>
                    </div>
                </div>

                <!-- Paso 4 -->
                <div class="col-md-4 col-lg-2 gc-fade-up gc-delay-4">
                    <div class="gc-step-card">
                        <div class="gc-step-number" style="background:var(--gc-yellow);color:var(--gc-gray);">4</div>
                        <span class="gc-step-emoji">🎨</span>
                        <h4 class="gc-step-title">Pintamos a mano</h4>
                        <p class="gc-step-desc">Nuestras artistas dan vida al diseño con pinceladas únicas.</p>
                    </div>
                </div>

                <!-- Paso 5 -->
                <div class="col-md-4 col-lg-2 gc-fade-up gc-delay-5">
                    <div class="gc-step-card">
                        <div class="gc-step-number" style="background:var(--gc-blue);">5</div>
                        <span class="gc-step-emoji">✏️</span>
                        <h4 class="gc-step-title">Personalizamos el nombre</h4>
                        <p class="gc-step-desc">El nombre de tu niño es el toque más especial de la lámpara.</p>
                    </div>
                </div>

                <!-- Paso 6 -->
                <div class="col-md-4 col-lg-2 gc-fade-up gc-delay-1">
                    <div class="gc-step-card">
                        <div class="gc-step-number" style="background:var(--gc-turquoise);">6</div>
                        <span class="gc-step-emoji">🎁</span>
                        <h4 class="gc-step-title">Empacamos con amor</h4>
                        <p class="gc-step-desc">Lista para ser el regalo más memorable de la infancia.</p>
                    </div>
                </div>

            </div>

            <!-- Fotos del proceso -->
            <div class="row g-2 mt-4">
                <div class="col-12 text-start mb-2">
                    <span style="font-size:0.85rem;color:var(--gc-gray);font-weight:600;">
                        📸 Fotos del proceso artesanal
                    </span>
                </div>
                <t t-foreach="[1,2,3,4,5,6]" t-as="i">
                    <div class="col-4 col-md-2">
                        <div class="gc-gallery-item" style="aspect-ratio:1;">
                            <!-- ▼▼▼ FOTOS DEL PROCESO ▼▼▼ -->
                            <div class="gc-media-placeholder" style="height:100%;">
                                <span style="font-size:1.5rem;opacity:0.5;">📷</span>
                                <span class="gc-ph-text" style="font-size:0.65rem;">Paso <t t-esc="i"/></span>
                            </div>
                        </div>
                    </div>
                </t>
            </div>

        </div>
    </section>


    <!-- ══════════════════════════════════
         SECCIÓN 5 — LA HISTORIA DE ANA
    ══════════════════════════════════ -->
    <section class="gc-section">
        <div class="container">
            <div class="gc-ana-section">
                <div class="row align-items-center g-5">

                    <!-- Foto Ana -->
                    <div class="col-lg-5 gc-fade-up">
                        <div style="border-radius:var(--gc-radius);overflow:hidden;aspect-ratio:4/5;">
                            <!-- ▼▼▼ FOTO DE ANA CON HELANA ▼▼▼ -->
                            <div class="gc-media-placeholder" style="height:380px;background:linear-gradient(135deg,var(--gc-peach),#FFD5C8);">
                                <span class="gc-ph-icon">👩‍👧</span>
                                <span class="gc-ph-text">
                                    Foto de Ana y Helana<br/>
                                    <small>Reemplaza desde el editor de Odoo</small>
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Texto Ana -->
                    <div class="col-lg-7 gc-fade-up gc-delay-2">
                        <span class="gc-section-label" style="background:var(--gc-coral);">
                            ❤️ Nuestra historia
                        </span>
                        <h2 class="gc-section-title mt-2">
                            Una mamá construyendo sueños mientras acompaña los de su hija
                        </h2>
                        <p style="font-size:0.97rem;color:var(--gc-gray);line-height:1.8;margin-top:1rem;">
                            Todo comenzó cuando Ana quiso crear algo completamente especial para Helana.
                            Lo que nació como un proyecto personal de amor se fue transformando en algo
                            mucho más grande: <strong>Gigi's Corner</strong>, un espacio donde cada lámpara
                            lleva el nombre de un niño, su historia, sus sueños y el amor de quienes la crearon.
                        </p>
                        <p style="font-size:0.97rem;color:var(--gc-gray);line-height:1.8;">
                            Hoy somos un equipo de madres que creamos mientras acompañamos la infancia
                            de nuestros propios hijos. Porque sabemos exactamente lo que significa
                            querer que cada rincón del cuarto de tu pequeño tenga alma propia.
                        </p>
                        <div class="d-flex gap-3 mt-4 flex-wrap">
                            <a href="/nosotros" class="gc-btn-primary">
                                ❤️ Conoce nuestra historia
                            </a>
                            <a href="/personalizados" class="gc-btn-secondary">
                                ✨ Crear mi lámpara
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>


    <!-- ══════════════════════════════════
         SECCIÓN 6 — EL EQUIPO
    ══════════════════════════════════ -->
    <section class="gc-section gc-section-cream">
        <div class="container text-center">
            <span class="gc-section-label" style="background:var(--gc-turquoise);">👐 Nuestro equipo</span>
            <h2 class="gc-section-title">Las manos detrás de cada historia</h2>
            <p class="gc-section-sub">
                Un proyecto construido principalmente por madres que crean<br/>
                mientras acompañan la infancia de sus hijos.
            </p>

            <div class="row g-4 justify-content-center mt-2">

                <!-- Ana -->
                <div class="col-6 col-md-3 gc-fade-up gc-delay-1">
                    <div class="gc-team-card">
                        <div class="gc-team-avatar" style="background:var(--gc-peach);">
                            <!-- ▼▼▼ FOTO ANA ▼▼▼ -->
                            <span>👩‍🎨</span>
                        </div>
                        <div class="gc-team-name">Ana</div>
                        <span class="gc-team-role" style="background:var(--gc-coral);">Fundadora</span>
                        <p class="gc-team-sub mt-1">Mamá de Helana<br/>Creadora y corazón del proyecto</p>
                    </div>
                </div>

                <!-- Marlene -->
                <div class="col-6 col-md-3 gc-fade-up gc-delay-2">
                    <div class="gc-team-card">
                        <div class="gc-team-avatar" style="background:var(--gc-light-blue);">
                            <!-- ▼▼▼ FOTO MARLENE ▼▼▼ -->
                            <span>🎨</span>
                        </div>
                        <div class="gc-team-name">Marlene</div>
                        <span class="gc-team-role" style="background:var(--gc-blue);">Diseño</span>
                        <p class="gc-team-sub mt-1">Mamá de Edrik y Rohan<br/>Diseño y desarrollo</p>
                    </div>
                </div>

                <!-- Leidy -->
                <div class="col-6 col-md-3 gc-fade-up gc-delay-3">
                    <div class="gc-team-card">
                        <div class="gc-team-avatar" style="background:var(--gc-mint);">
                            <!-- ▼▼▼ FOTO LEIDY ▼▼▼ -->
                            <span>✂️</span>
                        </div>
                        <div class="gc-team-name">Leidy</div>
                        <span class="gc-team-role" style="background:var(--gc-turquoise);">Producción</span>
                        <p class="gc-team-sub mt-1">Diseño y producción artesanal</p>
                    </div>
                </div>

                <!-- Bryan -->
                <div class="col-6 col-md-3 gc-fade-up gc-delay-4">
                    <div class="gc-team-card">
                        <div class="gc-team-avatar" style="background:#FFF0D0;">
                            <!-- ▼▼▼ FOTO BRYAN ▼▼▼ -->
                            <span>✏️</span>
                        </div>
                        <div class="gc-team-name">Bryan</div>
                        <span class="gc-team-role" style="background:var(--gc-yellow);color:var(--gc-gray);">Creativo</span>
                        <p class="gc-team-sub mt-1">Diseñador creativo<br/>Desarrollo visual</p>
                    </div>
                </div>

            </div>
        </div>
    </section>


    <!-- ══════════════════════════════════
         SECCIÓN 7 — GALERÍA DE FAMILIAS
    ══════════════════════════════════ -->
    <section class="gc-section gc-section-blue">
        <div class="container text-center">
            <span class="gc-section-label">📸 Galería</span>
            <h2 class="gc-section-title">Familias que iluminan sus historias</h2>
            <p class="gc-section-sub">Habitaciones reales, niños reales, momentos reales.</p>

            <div class="row g-2 mt-2">
                <!-- ▼▼▼ REEMPLAZA ESTAS IMÁGENES DESDE EL EDITOR DE ODOO ▼▼▼ -->
                <t t-foreach="['🏠 Sala','🛏️ Cuarto','🌙 Noche','✨ Encendida','👶 Bebé','🎁 Regalo','💡 Luz cálida','📸 Proceso','🎨 Arte','🌈 Colores','👨‍👩‍👧 Familia','🎉 Celebración']" t-as="label">
                    <div class="col-6 col-md-3 col-lg-2">
                        <div class="gc-gallery-item" style="height:130px;">
                            <div class="gc-media-placeholder" style="height:100%;background:linear-gradient(135deg,var(--gc-light-blue),var(--gc-mint));">
                                <span style="font-size:1.8rem;"><t t-esc="label.split(' ')[0]"/></span>
                                <span class="gc-ph-text" style="font-size:0.68rem;"><t t-esc="label"/></span>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </section>


    <!-- ══════════════════════════════════
         SECCIÓN 8 — TESTIMONIOS
    ══════════════════════════════════ -->
    <section class="gc-section-dark">
        <div class="container text-center">
            <span class="gc-section-label" style="background:var(--gc-yellow);color:var(--gc-gray);">
                ⭐ Reseñas
            </span>
            <h2 class="gc-section-title" style="color:white;">❤️ Lo que dicen las familias</h2>
            <p class="gc-section-sub" style="color:rgba(255,255,255,0.7);">
                Cada testimonio es una historia iluminada
            </p>

            <div class="row g-4 mt-2 text-start">

                <div class="col-md-4 gc-fade-up gc-delay-1">
                    <div class="gc-testimonial-card">
