                    ('3','🔨','Armamos cuidadosamente','Cada pieza encaja perfectamente con detalle y precisión.','#FF5C64'),
                    ('4','🎨','Pintamos a mano','Nuestras artistas dan vida al diseño con pinceladas únicas.','#F5C640'),
                    ('5','✏️','Personalizamos el nombre','El nombre de tu niño es el toque más especial de la lámpara.','#5DA7E8'),
                    ('6','🎁','Empacamos con amor','Lista para ser el regalo más memorable de la infancia.','#34C9B8')
                ]" t-as="paso">
                    <div class="col-6 col-md-4 col-lg-2">
                        <div style="background:white;border-radius:18px;padding:1.5rem 1rem;
                                    box-shadow:0 4px 24px rgba(93,167,232,0.13);height:100%;
                                    transition:transform 0.25s;"
                             onmouseover="this.style.transform='translateY(-5px)'"
                             onmouseout="this.style.transform='translateY(0)'">
                            <!-- Número con color -->
                            <div t-attf-style="width:36px;height:36px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-family:'Fredoka One',cursive;font-size:1.1rem;color:white;margin-bottom:0.8rem;background:#{paso[4]};">
                                <t t-esc="paso[0]"/>
                            </div>
                            <!-- Emoji -->
                            <div style="font-size:2rem;margin-bottom:0.7rem;">
                                <t t-esc="paso[1]"/>
                            </div>
                            <!-- Título -->
                            <h4 style="font-family:'Fredoka One',cursive;font-size:0.95rem;
                                       color:#1E3A5F;margin-bottom:0.4rem;">
                                <t t-esc="paso[2]"/>
                            </h4>
                            <!-- Descripción -->
                            <p style="font-size:0.8rem;color:#4B4B4B;opacity:0.8;
                                      line-height:1.6;margin:0;">
                                <t t-esc="paso[3]"/>
                            </p>
