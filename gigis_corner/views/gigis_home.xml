    <!-- ══════════════════════════════════
         SECCIÓN 4 — ASÍ NACE UNA LÁMPARA
    ══════════════════════════════════ -->
    <section style="background:#F7F3EB;padding:5rem 0;">
        <div class="container text-center">
            <span style="display:inline-block;background:#F5C640;color:#4B4B4B;font-size:0.78rem;
                         font-weight:700;padding:0.3rem 1rem;border-radius:50px;margin-bottom:1rem;">
                🔨 Proceso artesanal
            </span>
            <h2 style="font-family:'Fredoka One',cursive;font-size:2.1rem;color:#1E3A5F;margin-bottom:0.5rem;">
                Así nace una lámpara ✨
            </h2>
            <p style="font-size:1rem;color:#4B4B4B;opacity:0.8;margin-bottom:2.5rem;">
                Cada paso es un acto de amor artesanal
            </p>

            <div class="row g-3 mt-2">

                <t t-foreach="[
                    ('1','💡','Diseñamos la idea','Conversamos contigo sobre la historia y sueños de tu pequeño.','#5DA7E8'),
                    ('2','✂️','Cortamos cada pieza','Con precisión artesanal cortamos el MDF según el diseño único.','#34C9B8'),
                    ('3','🔨','Armamos cuidadosamente','Cada pieza encaja perfectamente con detalle y precisión.','#FF5C64'),
                    ('4','🎨','Pintamos a mano','Nuestras artistas dan vida al diseño con pinceladas únicas.','#F5C640'),
                    ('5','✏️','Personalizamos el nombre','El nombre de tu niño es el toque más especial de la lámpara.','#5DA7E8'),
                    ('6','🎁','Empacamos con amor','Lista para ser el regalo más memorable de la infancia.','#34C9B8')
                ]" t-as="paso">
                    <div class="col-6 col-md-4 col-lg-2">
                        <div style="background:white;border-radius:18px;padding:1.5rem 1rem;
                                    box-shadow:0 4px 24px rgba(93,167,232,0.13);height:100%;
                                    transition:transform 0.25s;"
                             onmouseover="this.style.transform='translateY(-5px)'"
                             onmouseout="this.style.transform='translateY(0)'">
                            <!-- Número con color -->
                            <div t-attf-style="width:36px;height:36px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-family:'Fredoka One',cursive;font-size:1.1rem;color:white;margin-bottom:0.8rem;background:#{paso[4]};">
                                <t t-esc="paso[0]"/>
                            </div>
                            <!-- Emoji -->
                            <div style="font-size:2rem;margin-bottom:0.7rem;">
                                <t t-esc="paso[1]"/>
                            </div>
                            <!-- Título -->
                            <h4 style="font-family:'Fredoka One',cursive;font-size:0.95rem;
                                       color:#1E3A5F;margin-bottom:0.4rem;">
                                <t t-esc="paso[2]"/>
                            </h4>
                            <!-- Descripción -->
                            <p style="font-size:0.8rem;color:#4B4B4B;opacity:0.8;
                                      line-height:1.6;margin:0;">
                                <t t-esc="paso[3]"/>
                            </p>
                        </div>
                    </div>
                </t>

            </div>

            <!-- Fotos del proceso -->
            <div class="row g-2 mt-4">
                <div class="col-12 text-start mb-2">
                    <span style="font-size:0.85rem;color:#4B4B4B;font-weight:600;">
                        📸 Fotos del proceso artesanal
                    </span>
                </div>
                <t t-foreach="[
                    ('💡','Diseño'),('✂️','Corte'),('🔨','Armado'),
                    ('🎨','Pintado'),('✏️','Nombre'),('🎁','Empaque')
                ]" t-as="foto">
                    <div class="col-4 col-md-2">
                        <div style="border-radius:10px;overflow:hidden;aspect-ratio:1;
                                    background:linear-gradient(135deg,#D6EDFB,#C8F5F1);
                                    cursor:pointer;transition:transform 0.25s;"
                             onmouseover="this.style.transform='scale(1.04)'"
                             onmouseout="this.style.transform='scale(1)'">
                            <!-- ▼▼▼ REEMPLAZA: foto del paso ▼▼▼ -->
                            <div style="width:100%;height:100%;display:flex;flex-direction:column;
                                        align-items:center;justify-content:center;min-height:90px;">
                                <span style="font-size:1.8rem;opacity:0.6;">
                                    <t t-esc="foto[0]"/>
                                </span>
                                <span style="font-size:0.65rem;color:#5DA7E8;font-weight:600;
                                             opacity:0.7;margin-top:0.3rem;">
                                    <t t-esc="foto[1]"/>
                                </span>
                            </div>
                        </div>
                    </div>
                </t>
            </div>

        </div>
    </section>


