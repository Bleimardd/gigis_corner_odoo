<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Registro único de configuración (se crea una sola vez) -->
    <data noupdate="1">
        <record id="gigis_config_main" model="gigis.config">
            <field name="name">Configuración</field>
            <field name="notif_activo" eval="True"/>
        </record>
    </data>

    <data>
        <!-- ═══════════════════════════════════════════════════════
             FORMULARIO — gigis.config
             ═══════════════════════════════════════════════════════ -->
        <record id="view_gigis_config_form" model="ir.ui.view">
            <field name="name">gigis.config.form</field>
            <field name="model">gigis.config</field>
            <field name="arch" type="xml">
                <form string="Configuración">
                    <sheet>
                        <div class="oe_title">
                            <h1>Configuración de Gigi's Corner</h1>
                        </div>
                        <group>
                            <group string="Solicitudes del formulario «Personalizados»">
                                <field name="notif_activo"/>
                                <field name="notif_email" widget="email"
                                       placeholder="info@gigiscorner.com.mx"
                                       required="notif_activo"/>
                            </group>
                        </group>
                        <p class="text-muted">
                            Cuando alguien envía el formulario de «Personalizados», la solicitud se
                            guarda en <b>Solicitudes</b> y, si el aviso está activo, se manda una copia
                            a este correo. Puedes poner varios correos separados por coma.
                            (Requiere un servidor de correo saliente configurado en Odoo.)
                        </p>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════
             ACCIÓN — abre directamente el registro único
             ═══════════════════════════════════════════════════════ -->
        <record id="action_gigis_config" model="ir.actions.act_window">
            <field name="name">Configuración</field>
            <field name="res_model">gigis.config</field>
            <field name="view_mode">form</field>
            <field name="res_id" eval="ref('gigis_config_main')"/>
            <field name="target">current</field>
        </record>

        <!-- ═══════════════════════════════════════════════════════
             MENÚ — Gigi's Corner → Configuración
             ═══════════════════════════════════════════════════════ -->
        <menuitem id="menu_gigis_config"
                  name="Configuración"
                  parent="menu_gigis_root"
                  action="action_gigis_config"
                  sequence="90"/>
    </data>

</odoo>
