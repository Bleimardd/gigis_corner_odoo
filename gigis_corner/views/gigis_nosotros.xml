                        <h2 class="gc-chapter-title">El equipo de madres creadoras</h2>
                        <!-- ▼▼▼ FOTO DEL EQUIPO ▼▼▼ -->
                        <div style="border-radius:10px;overflow:hidden;
                                    height:200px;margin-bottom:1rem;">
