                                <div style="background:white;border-radius:10px;padding:0.8rem;text-align:center;">
                                    <div style="font-size:1.5rem;">🎨</div>
                                    <div style="font-size:0.8rem;font-weight:600;color:#1E3A5F;">100% Artesanal</div>
