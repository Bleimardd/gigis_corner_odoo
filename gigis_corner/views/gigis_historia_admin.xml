<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         VISTA FORMULARIO — gigis.historia (backend / administración)
         ═══════════════════════════════════════════════════════════ -->
    <record id="view_gigis_historia_form" model="ir.ui.view">
        <field name="name">gigis.historia.form</field>
        <field name="model">gigis.historia</field>
        <field name="arch" type="xml">
            <form string="Historia">
                <sheet>
                    <div class="oe_title">
                        <label for="titulo"/>
                        <h1>
                            <field name="titulo" placeholder="Ej: Amira y el Mar"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Datos básicos">
                            <field name="slug" placeholder="amira-y-el-mar"/>
                            <field name="nombre_nino" placeholder="Amira"/>
                            <field name="subtitulo" placeholder="Una niña que soñaba con el océano"/>
                            <field name="etiqueta" placeholder="🌊 Mar"/>
                            <field name="emoji" placeholder="🌊"/>
                            <field name="color_fondo" placeholder="#D6EDFB"/>
                        </group>
                        <group string="Publicación">
                            <field name="sequence"/>
                            <field name="website_published"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <group string="Imágenes y video (se muestran en la web)">
                        <group>
                            <field name="imagen_principal" widget="image"
                                   options="{'size': [400, 300]}"/>
                            <field name="video_url"
                                   placeholder="https://...  (link a un video .mp4 o YouTube)"/>
                        </group>
                    </group>

                    <group string="Fotos del proceso (opcionales, hasta 4)">
                        <group>
                            <field name="foto_proceso_1" widget="image" options="{'size': [200, 200]}"/>
                            <field name="foto_proceso_2" widget="image" options="{'size': [200, 200]}"/>
                        </group>
                        <group>
                            <field name="foto_proceso_3" widget="image" options="{'size': [200, 200]}"/>
                            <field name="foto_proceso_4" widget="image" options="{'size': [200, 200]}"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Extracto (tarjeta)">
                            <field name="extracto"
                                   placeholder="1-2 frases que aparecen en la tarjeta de la lista de historias."/>
                        </page>
                        <page string="La historia">
                            <field name="capitulo_historia"
                                   placeholder="Quién es el niño/a y cuál era su sueño."/>
                        </page>
                        <page string="El proceso">
                            <field name="capitulo_proceso"
                                   placeholder="Cómo diseñaron y crearon la lámpara."/>
                        </page>
                        <page string="El resultado">
                            <field name="capitulo_resultado"
                                   placeholder="La reacción del niño/a y cómo la usa hoy."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         VISTA LISTA — gigis.historia
         ═══════════════════════════════════════════════════════════ -->
    <record id="view_gigis_historia_tree" model="ir.ui.view">
        <field name="name">gigis.historia.tree</field>
        <field name="model">gigis.historia</field>
        <field name="arch" type="xml">
            <tree string="Historias">
                <field name="sequence" widget="handle"/>
                <field name="titulo"/>
                <field name="nombre_nino"/>
                <field name="etiqueta"/>
                <field name="slug"/>
                <field name="website_published"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         VISTA KANBAN (con miniatura)
         ═══════════════════════════════════════════════════════════ -->
    <record id="view_gigis_historia_kanban" model="ir.ui.view">
        <field name="name">gigis.historia.kanban</field>
        <field name="model">gigis.historia</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="titulo"/>
                <field name="etiqueta"/>
                <field name="nombre_nino"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <field name="imagen_principal" widget="image"
                                   class="o_kanban_image_fill_left"
                                   options="{'zoom': true, 'background': true, 'preventClicks': false}"/>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="titulo"/>
                                </strong>
                                <div>
                                    <field name="etiqueta"/>
                                </div>
                                <div class="text-muted">
                                    <field name="nombre_nino"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         ACCIÓN
         ═══════════════════════════════════════════════════════════ -->
    <record id="action_gigis_historia" model="ir.actions.act_window">
        <field name="name">Historias</field>
        <field name="res_model">gigis.historia</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea la primera historia de Gigi's Corner
            </p>
            <p>
                Cada historia aparece en la página /historias.
                Sube aquí la foto principal, el video y las fotos del proceso.
            </p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         MENÚS
         ═══════════════════════════════════════════════════════════ -->
    <menuitem id="menu_gigis_root"
              name="Gigi's Corner"
              web_icon="gigis_corner,static/src/img/logo.png"
              sequence="50"/>

    <menuitem id="menu_gigis_historias_admin"
              name="Historias"
              parent="menu_gigis_root"
              action="action_gigis_historia"
              sequence="10"/>

    <!-- ═══════════════════════════════════════════════════════════
         SOLICITUDES DE PERSONALIZACIÓN (pedidos del formulario)
         ═══════════════════════════════════════════════════════════ -->
    <record id="view_gigis_personalizacion_form" model="ir.ui.view">
        <field name="name">gigis.personalizacion.form</field>
        <field name="model">gigis.personalizacion</field>
        <field name="arch" type="xml">
            <form string="Solicitud de personalización">
                <header>
                    <field name="state" widget="statusbar" clickable="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="nombre_nino"/></h1>
                    </div>
                    <group>
                        <group string="Sobre el niño/a">
                            <field name="edad"/>
                            <field name="tema_favorito"/>
                            <field name="colores"/>
                        </group>
                        <group string="Contacto">
                            <field name="nombre_contacto"/>
                            <field name="telefono" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="fecha_requerida"/>
                        </group>
                    </group>
                    <group>
                        <group string="Detalles">
                            <field name="presupuesto"/>
                            <field name="como_conocio"/>
                        </group>
                    </group>
                    <group string="Historia detrás del diseño">
                        <field name="historia" nolabel="1"/>
                    </group>
                    <group string="Notas internas">
                        <field name="notas_internas" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gigis_personalizacion_tree" model="ir.ui.view">
        <field name="name">gigis.personalizacion.tree</field>
        <field name="model">gigis.personalizacion</field>
        <field name="arch" type="xml">
            <tree string="Solicitudes">
                <field name="create_date" string="Recibido"/>
                <field name="nombre_nino"/>
                <field name="nombre_contacto"/>
                <field name="telefono"/>
                <field name="tema_favorito"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_gigis_personalizacion_kanban" model="ir.ui.view">
        <field name="name">gigis.personalizacion.kanban</field>
        <field name="model">gigis.personalizacion</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <field name="nombre_nino"/>
                <field name="nombre_contacto"/>
                <field name="telefono"/>
                <field name="tema_favorito"/>
                <field name="create_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_record_top mb-1">
                                <strong class="o_kanban_record_title"><field name="nombre_nino"/></strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>👤 <field name="nombre_contacto"/></div>
                                <div t-if="record.telefono.raw_value">📱 <field name="telefono"/></div>
                                <div t-if="record.tema_favorito.raw_value">🦋 <field name="tema_favorito"/></div>
                            </div>
                            <div class="o_kanban_record_bottom mt-1">
                                <div class="oe_kanban_bottom_left text-muted">
                                    <field name="create_date" widget="date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_gigis_personalizacion" model="ir.actions.act_window">
        <field name="name">Solicitudes</field>
        <field name="res_model">gigis.personalizacion</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aquí llegan las solicitudes del formulario "Personalizados"
            </p>
        </field>
    </record>

    <menuitem id="menu_gigis_personalizacion_admin"
              name="Solicitudes"
              parent="menu_gigis_root"
              action="action_gigis_personalizacion"
              sequence="20"/>

</odoo>
