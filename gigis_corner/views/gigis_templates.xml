<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ═══════════════════════════════════════════════════════════
     ESTILOS INLINE — inyectados directo en el <head>
     Esto garantiza que los estilos carguen aunque los assets
     estáticos fallen. Se complementa con los archivos CSS.
     ═══════════════════════════════════════════════════════════ -->
<template id="gigis_assets_head" inherit_id="website.layout" name="Gigi's Corner — Head Assets">
    <xpath expr="//head" position="inside">
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
        <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&amp;family=Poppins:wght@400;600;700&amp;display=swap"
              rel="stylesheet"/>
    </xpath>
</template>

<!-- ═══════════════════════════════════════════════════════════
     NAVBAR — reemplaza el header completo
     Se usa //header (más estable que //nav en Odoo 17)
     ═══════════════════════════════════════════════════════════ -->
<template id="gigis_navbar" inherit_id="website.layout" name="Gigi's Corner — Navbar">
    <xpath expr="//header" position="replace">
        <header>
            <nav class="gc-navbar navbar navbar-expand-lg"
                 style="background:#FFFDF8;box-shadow:0 2px 14px rgba(30,58,95,0.07);padding:0.6rem 0;">
                <div class="container">

                    <!-- Logo (incrustado en el módulo) -->
                    <a class="navbar-brand d-flex align-items-center" href="/">
                        <img src="/gigis_corner/static/src/img/logo.png"
                             alt="Gigi's Corner"
                             style="height:54px;width:auto;object-fit:contain;"/>
                    </a>

                    <button class="navbar-toggler border-0" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#gcNavMenu"
                            aria-expanded="false">
                        <span class="navbar-toggler-icon"/>
                    </button>

                    <div class="collapse navbar-collapse" id="gcNavMenu">
                        <!-- Menú centrado -->
                        <ul class="navbar-nav mx-auto gap-lg-4 gap-1">
                            <li class="nav-item">
                                <a class="nav-link gc-nav-link" href="/">Inicio</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link gc-nav-link" href="/historias">Historias</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link gc-nav-link" href="/nosotros">Nosotros</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link gc-nav-link" href="/personalizados">Personalizados</a>
                            </li>
                        </ul>

                        <!-- Acciones derecha -->
                        <div class="d-flex align-items-center gap-2 mt-2 mt-lg-0">
                            <!-- WhatsApp burbuja verde suave -->
                            <a href="https://wa.me/525529451680" target="_blank"
                               title="WhatsApp"
                               style="width:38px;height:38px;border-radius:50%;background:#EAF7EE;
                                      color:#25D366;display:inline-flex;align-items:center;
                                      justify-content:center;font-size:1.15rem;text-decoration:none;
                                      flex-shrink:0;">
                                <i class="fa fa-whatsapp"/>
                            </a>
                            <!-- 1º Diseñar mi lámpara -->
                            <a href="/personalizados"
                               style="background:#FF5C64;color:white;border:none;border-radius:50px;
                                      padding:0.5rem 1.4rem;font-weight:700;font-size:0.88rem;
                                      text-decoration:none;white-space:nowrap;">
                                Diseñar mi lámpara
                            </a>
                            <!-- 2º Entrar / Mi cuenta -->
                            <t t-if="not request.env.user._is_public()">
                                <a href="/my"
                                   style="display:inline-flex;align-items:center;gap:0.35rem;
                                          color:#5DA7E8;font-weight:700;font-size:0.88rem;
                                          text-decoration:none;white-space:nowrap;padding:0.3rem 0.5rem;">
                                    <i class="fa fa-user-circle"/> Mi cuenta
                                </a>
                            </t>
                            <t t-else="">
                                <a t-attf-href="/web/login?redirect=#{request.httprequest.path}"
                                   style="display:inline-flex;align-items:center;gap:0.35rem;
                                          color:#5DA7E8;font-weight:700;font-size:0.88rem;
                                          text-decoration:none;white-space:nowrap;padding:0.3rem 0.5rem;">
                                    <i class="fa fa-user"/> Entrar
                                </a>
                            </t>
                        </div>
                    </div>

                </div>
            </nav>
        </header>
    </xpath>
</template>


<!-- ═══════════════════════════════════════════════════════════
     FOOTER
     ═══════════════════════════════════════════════════════════ -->
<template id="gigis_footer" inherit_id="website.layout" name="Gigi's Corner — Footer">
