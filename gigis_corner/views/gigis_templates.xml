                                <li style="margin-bottom:0.5rem;"><a href="/personalizados" style="color:rgba(255,255,255,0.6);text-decoration:none;font-size:0.88rem;">Personalizados</a></li>
                            </ul>
                        </div>

                        <div class="col-lg-2 col-6">
                            <h5 style="font-family:'Fredoka One',cursive;color:white;margin-bottom:1rem;">Historias</h5>
                            <ul style="list-style:none;padding:0;margin:0;">
                                <li style="margin-bottom:0.5rem;"><a href="/historias/amira-y-el-mar" style="color:rgba(255,255,255,0.6);text-decoration:none;font-size:0.88rem;">🌊 Amira y el Mar</a></li>
                                <li style="margin-bottom:0.5rem;"><a href="/historias/pepe-la-tortuga" style="color:rgba(255,255,255,0.6);text-decoration:none;font-size:0.88rem;">🐢 Pepe la Tortuga</a></li>
                                <li style="margin-bottom:0.5rem;"><a href="/historias/valentina-astronauta" style="color:rgba(255,255,255,0.6);text-decoration:none;font-size:0.88rem;">🚀 Valentina</a></li>
                                <li style="margin-bottom:0.5rem;"><a href="/historias/mateo-constructor" style="color:rgba(255,255,255,0.6);text-decoration:none;font-size:0.88rem;">🚜 Mateo</a></li>
                            </ul>
                        </div>

                        <div class="col-lg-4">
                            <h5 style="font-family:'Fredoka One',cursive;color:white;margin-bottom:1rem;">Contacto</h5>
                            <ul style="list-style:none;padding:0;margin:0;">
                                <li style="margin-bottom:0.5rem;">
                                    <a href="https://wa.me/525529451680" target="_blank"
                                       style="color:rgba(255,255,255,0.6);text-decoration:none;font-size:0.88rem;">
                                        💬 +52 55 2945 1680
                                    </a>
                                </li>
                                <li style="margin-bottom:0.5rem;">
                                    <a href="mailto:info@gigiscorner.com.mx"
                                       style="color:rgba(255,255,255,0.6);text-decoration:none;font-size:0.88rem;">
                                        📧 info@gigiscorner.com.mx
                                    </a>
                                </li>
                                <li style="color:rgba(255,255,255,0.5);font-size:0.85rem;margin-top:0.4rem;">
                                    📍 Benito Juárez 95, Isidro Fabela,<br/>Tlalpan, CDMX
                                </li>
                            </ul>
                            <a href="/personalizados"
                               style="display:inline-flex;align-items:center;gap:0.4rem;
                                      background:#FF5C64;color:white;border-radius:50px;
